{
  "name": "opencode-failover",
  "version": "0.1.0",
  "description": "Automatic failover proxy between OpenCode free models when quota is exhausted.",
  "type": "module",
  "bin": {
    "opencode-failover-bootcracker": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "cli": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json && chmod +x dist/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
