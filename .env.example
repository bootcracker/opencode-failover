# Port the proxy listens on
PORT=8787

# Host the proxy listens on
HOST=0.0.0.0

# OpenCode Console API key (required) - used to authenticate against the OpenCode inference gateway
OPENCODE_API_KEY=sk-ant-your-key-here

# OpenCode inference base URL
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1

# Max models to try before giving up (defaults to the number of free models)
FAILOVER_MAX_ATTEMPTS=14
